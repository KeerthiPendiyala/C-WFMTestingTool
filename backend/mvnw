#!/usr/bin/env sh
set -eu
BASE_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
WRAPPER_DIR="$BASE_DIR/.mvn/wrapper"
MAVEN_HOME="$WRAPPER_DIR/apache-maven-3.9.9"
MAVEN_CMD="$MAVEN_HOME/bin/mvn"
if [ ! -x "$MAVEN_CMD" ]; then
  if [ -z "${JAVA_HOME:-}" ]; then
    echo "JAVA_HOME must point to a Java 21 JDK before running the Maven wrapper." >&2
    exit 1
  fi
  mkdir -p "$WRAPPER_DIR"
  ZIP="$WRAPPER_DIR/apache-maven-3.9.9-bin.zip"
  if [ ! -f "$ZIP" ]; then
    if command -v curl >/dev/null 2>&1; then
      curl -fsSL "https://archive.apache.org/dist/maven/maven-3/3.9.9/binaries/apache-maven-3.9.9-bin.zip" -o "$ZIP"
    else
      wget -q "https://archive.apache.org/dist/maven/maven-3/3.9.9/binaries/apache-maven-3.9.9-bin.zip" -O "$ZIP"
    fi
  fi
  if command -v unzip >/dev/null 2>&1; then
    unzip -q -o "$ZIP" -d "$WRAPPER_DIR"
  else
    (
      cd "$WRAPPER_DIR"
      jar xf "$ZIP"
    )
  fi
fi
exec "$MAVEN_CMD" -f "$BASE_DIR/pom.xml" "$@"
